{
  "name": "blog",
  "type": "module",
  "scripts": {
    "postinstall": "pnpm typegen",
    "prepare": "panda codegen",
    "dev": "vite",
    "build": "panda && vite build --mode client && vite build",
    "preview": "wrangler dev --env preview",
    "deploy": "wrangler deploy --env production",
    "deploy:preview": "wrangler versions upload --env preview --preview-alias preview",
    "check": "biome ci ./app vite.config.ts vitest.config.ts",
    "fmt": "biome format --write ./app vite.config.ts",
    "test": "vitest run",
    "typegen": "wrangler types --env-interface=CloudflareEnv",
    "setLocalDB": "LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit)",
    "setPreviewDB": "DB_ID='fe62b702-8f6b-4b85-81c0-e315529e6ca7'",
    "setProdDB": "DB_ID='77f4589e-54f5-43ad-ab44-ccc96e048bfc'",
    "db:push": "pnpm setLocalDB drizzle-kit push",
    "db:push:prev": "pnpm setPreviewDB drizzle-kit push",
    "db:push:prod": "pnpm setProdDB drizzle-kit push",
    "db:studio": "pnpm setLocalDB drizzle-kit studio",
    "db:studio:prev": "pnpm setPreviewDB drizzle-kit studio",
    "db:studio:prod": "pnpm setProdDB drizzle-kit studio"
  },
  "private": true,
  "dependencies": {
    "@hono/valibot-validator": "^0.6.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/markdown-it-container": "^4.0.1",
    "drizzle-orm": "^0.45.3",
    "drizzle-valibot": "^0.4.2",
    "hono": "4.11.7",
    "honox": "^0.1.61",
    "lucide": "^1.52.0",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "prismjs": "^1.30.0",
    "thumbhash": "^0.1.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@pandacss/dev": "^2.1.2",
    "@pandacss/preset-base": "^2.1.2",
    "@pandacss/preset-panda": "^2.1.2",
    "@pandacss/studio": "^1.12.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "es-module-lexer": "^3.0.3",
    "postcss": "^8.5.29",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
